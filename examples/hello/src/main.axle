// hello — the smallest program that has a command line worth the name.
//
// Build & run:  axle build, then  target/hello serve --port 9000 site   (or --help, or a typo of either)

use clinch::{Arg, Command, CliError, Opt, Parsed, Parser, UsageError, Values};
use std::sys::process::{argAt, argc};

/** What this program accepts. */
fn spec() : Command {
    let root : Command = Command::create("hello", "A tiny server that serves nothing");
    root.version("0.1.0");
    root.add(Opt::flag("-v, --verbose", "Say more"));
    let serve : Command = Command::create("serve", "Pretend to serve a folder");
    serve.alias("run");
    serve.add(Opt::integer("-p, --port <n>", "Port to listen on", "8080"));
    serve.arg(Arg::required("root", "Folder to serve"));
    root.sub(serve);
    return root;
}

/** The words after the program's name. */
fn words() : Values<string> {
    let out : Values<string> = new Values<string>();
    for (i of 1..argc()) {
        out.add(argAt(i));
    }
    return out;
}

fn main() : i32 {
    try {
        let parsed : Parsed = Parser::parse(spec(), words());
        println(parsed.path() + ": serving " + parsed.arg("root") + " on " + parsed.text("port"));
        return 0;
    } catch (e : UsageError) {
        println("error: " + e.message);
        if (e.hint != "") {
            println("  " + e.hint);
        }
        return e.code;
    }
}
