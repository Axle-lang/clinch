// hello — the smallest program that has a command line worth the name.
//
// Build & run:  axle build, then  target/hello serve --port 9000 site   (or --version, or a typo of either)

use clinch::{Arg, Command, Opt, Parsed, UsageError, parseProcess};

/** What this program accepts. */
fn spec() : Command {
    let serve : Command = Command::create("serve", "Pretend to serve a folder")
        .alias("run")
        .add(Opt::integer("-p, --port <n>", "Port to listen on", "8080"))
        .arg(Arg::required("root", "Folder to serve"));
    return Command::create("hello", "A tiny server that serves nothing")
        .version("0.1.0")
        .example("hello serve site", "serve the folder on the default port")
        .add(Opt::flag("-v, --verbose", "Say more"))
        .sub(serve);
}

fn main() : i32 {
    try {
        let parsed : Parsed = parseProcess(spec());
        if (parsed.versionAsked) {
            println(parsed.versionLine());
            return 0;
        }
        if (parsed.helpAsked) {
            println(parsed.help());
            return 0;
        }
        println(parsed.path() + ": serving " + parsed.arg("root") + " on " + parsed.text("port"));
        return 0;
    } catch e : UsageError {
        println(e.report());
        return e.code;
    }
}
