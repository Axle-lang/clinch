// parse — a command line turned into answers.
//
//     let input : Input = listenTo(root, argv);
//     let port : i64 = input.integer("port");
//
// The parser reads the words of `argv` against a `Command`: options in their long form (`--port 80`,
// `--port=80`) or short (`-p 80`, `-p80`, and clusters of flags, `-abc`), the subcommand that names the
// command the rest is read against, positional arguments, and `--`, after which every word is a
// positional. It checks each value against the kind its option declares and refuses with a
// `UsageError` that says what is wrong and, when it can tell, what was meant.
//
// `listenToRaw` is the same without the defaults, so that the environment and a file can be offered first.
//
// What comes out remembers where each answer came from (`Source`), because an option can also be set
// by the environment, by a config file, or by its declared default, and the person asking "why is this
// 4?" deserves an answer. The command line wins over the environment, which wins over the file, which
// wins over the default; `Input::offer` is how the lower sources add what the line did not say.

use crate::error::{InvalidValue, MissingArgument, MissingValue, UnexpectedArgument, UnknownCommand, UnknownOption, UsageError};
use std::collections::ArrayList;
use crate::help::helpText;
use crate::list::{List, Values};
use crate::spec::{Arg, Command, Kind, Opt};
use crate::suggest::nearestWord;
use crate::text::{realNumber, slice, sliceFrom, wholeNumber};

/** Where an answer came from, lowest to highest: a higher source replaces a lower one. */
pub enum Source : i32 {
    /** The default the option declares. */
    Default = 0,

    /** A config file. */
    Config = 1,

    /** An environment variable. */
    Env = 2,

    /** The command line. */
    Argv = 3,

    /** Its place in the order of precedence. */
    pub fn rank(self) : i32 {
        return match self {
            Source::Default => 0,
            Source::Config => 1,
            Source::Env => 2,
            Source::Argv => 3,
        };
    }

    /** It is called in a sentence: "the command line", "the environment". */
    pub fn label(self) : string {
        return match self {
            Source::Default => "the default",
            Source::Config => "the config file",
            Source::Env => "the environment",
            Source::Argv => "the command line",
        };
    }
}

/** What was typed, read against the command it names. */
pub class Input {
    /** The commands from the root down to the one the line named; the last is the one that runs. */
    pub levels       : List<Command>;

    /** Whether `-h` or `--help` was given: nothing else was read. */
    pub helpAsked    : bool = false;

    /** Whether `-V` or `--version` was given. */
    pub versionAsked : bool = false;

    names   : ArrayList<string>;
    values  : ArrayList<string>;
    origins : ArrayList<i32>;
    pos     : ArrayList<string>;

    constructor() {
        self.levels = new List<Command>();
        self.names = new ArrayList<string>();
        self.values = new ArrayList<string>();
        self.origins = new ArrayList<i32>();
        self.pos = new ArrayList<string>();
    }

    /** The command that runs: the deepest the line reached. */
    pub fn command(self) : Command {
        return self.levels.at(self.levels.size() - 1);
    }

    /** Its name and its ancestors', joined by spaces: `git remote add`. */
    pub fn path(self) : string {
        let mut out : string = "";
        for (i of 0..self.levels.size()) {
            out = i == 0 ? self.levels.at(i).name : out + " " + self.levels.at(i).name;
        }
        return out;
    }

    /** What `--help` prints for the command the line reached. */
    pub fn help(self) : string {
        return helpText(self.levels, self.path());
    }

    /** What `--version` prints: the program's name and its version, `tool 1.2.0`. */
    pub fn versionLine(self) : string {
        let root : Command = self.levels.at(0);
        if (root.ver == "") {
            return root.name;
        }
        return root.name + " " + root.ver;
    }

    /** Note that help was asked for. */
    pub fn askHelp(mut self) : void {
        self.helpAsked = true;
    }

    /** Note that the version was asked for. */
    pub fn askVersion(mut self) : void {
        self.versionAsked = true;
    }

    /** Record an answer, whatever came before it. */
    pub fn put(mut self, name : string, value : string, source : Source) : void {
        self.names.add(name);
        self.values.add(value);
        self.origins.add(source.rank());
    }

    /**
     * Record an answer from a lower source: kept only if `name` has no answer yet from a source at least
     * as high. This is how the environment, a file and the defaults fill in what the line left unsaid.
     */
    pub fn offer(mut self, name : string, value : string, source : Source) : void {
        let at : i32 = self.last(name);
        if (at >= 0 && (self.origins.get(at) ?? 0) >= (source as i32)) {
            return;
        }
        self.put(name, value, source);
    }

    /** The position of the newest answer for `name`, or -1. */
    fn last(self, name : string) : i32 {
        let mut i : i32 = self.names.size() - 1;
        while (i >= 0) {
            if ((self.names.get(i) ?? "") == name) {
                return i;
            }
            i = i - 1;
        }
        return -1;
    }

    /** Whether `name` has an answer, from whatever source. */
    pub fn has(self, name : string) : bool {
        return self.last(name) >= 0;
    }

    /** Whether a flag is on. An absent flag is off. */
    pub fn flag(self, name : string) : bool {
        let at : i32 = self.last(name);
        return at >= 0 && (self.values.get(at) ?? "") != "false";
    }

    /** The text of `name`; empty when it has none. */
    pub fn text(self, name : string) : string {
        let at : i32 = self.last(name);
        return at < 0 ? "" : (self.values.get(at) ?? "");
    }

    /** The whole number `name` holds; 0 when it has none (an option declared `integer` was checked). */
    pub fn integer(self, name : string) : i64 {
        let (ok, n) = wholeNumber(self.text(name));
        return n;
    }

    /** The number `name` holds; 0 when it has none. */
    pub fn number(self, name : string) : f64 {
        let (ok, x) = realNumber(self.text(name));
        return x;
    }

    /** Every answer given for `name`, oldest first (for an option that may be repeated). */
    pub fn all(self, name : string) : ArrayList<string> {
        let out : ArrayList<string> = new ArrayList<string>();
        for (i of 0..self.names.size()) {
            if ((self.names.get(i) ?? "") == name) {
                out.add((self.values.get(i) ?? ""));
            }
        }
        return out;
    }

    /** Where the answer for `name` came from; `Default` when it has none. */
    pub fn source(self, name : string) : Source {
        let at : i32 = self.last(name);
        if (at < 0) {
            return Source::Default;
        }
        return match (self.origins.get(at) ?? 0) {
            3 => Source::Argv,
            2 => Source::Env,
            1 => Source::Config,
            _ => Source::Default,
        };
    }

    /** The positional argument called `name`; empty when it was not given. */
    pub fn arg(self, name : string) : string {
        let args : Values<Arg> = self.command().args;
        for (i of 0..args.size()) {
            if (args.at(i).name == name) {
                return i < self.pos.size() ? (self.pos.get(i) ?? "") : "";
            }
        }
        return "";
    }

    /** The positional arguments from the one called `name` on, for the argument that takes the rest. */
    pub fn rest(self, name : string) : ArrayList<string> {
        let out : ArrayList<string> = new ArrayList<string>();
        let args : Values<Arg> = self.command().args;
        for (i of 0..args.size()) {
            if (args.at(i).name == name) {
                for (k of i..self.pos.size()) {
                    out.add((self.pos.get(k) ?? ""));
                }
            }
        }
        return out;
    }

    /** The positional argument at position `i`. */
    pub fn at(self, i : i32) : string {
        return (self.pos.get(i) ?? "");
    }

    /** How many positional arguments were given. */
    pub fn count(self) : i32 {
        return self.pos.size();
    }

    /** Record a positional argument. */
    pub fn push(mut self, value : string) : void {
        self.pos.add(value);
    }

    /** Add what the options declare as defaults, for those nothing else set. */
    pub fn seal(mut self) : void {
        for (l of 0..self.levels.size()) {
            let c : Command = self.levels.at(l);
            for (i of 0..c.opts.size()) {
                let o : Opt = c.opts.at(i);
                if (o.fallback != "") {
                    self.offer(o.name, o.fallback, Source::Default);
                }
            }
        }
    }
}

/** The option called `name` at the deepest level that declares it, or nothing (`found == false`). */
fn findOption(out : Input, name : string, letter : string) : (found: bool, opt: Opt) {
    let mut l : i32 = out.levels.size() - 1;
    while (l >= 0) {
        let c : Command = out.levels.at(l);
        let at : i32 = name == "" ? c.findShort(letter) : c.findLong(name);
        if (at >= 0) {
            return (true, c.opts.at(at));
        }
        l = l - 1;
    }
    return (false, Opt::flag("", ""));
}

/** Every long option the line may use, for suggestions. */
fn longNames(out : Input) : ArrayList<string> {
    let names : ArrayList<string> = new ArrayList<string>();
    for (l of 0..out.levels.size()) {
        let c : Command = out.levels.at(l);
        for (i of 0..c.opts.size()) {
            if (c.opts.at(i).name != "" && !c.opts.at(i).hidden) {
                names.add("--" + c.opts.at(i).name);
            }
        }
    }
    names.add("--help");
    if (out.levels.at(0).ver != "") {
        names.add("--version");
    }
    return names;
}

/** One `--name` or `--name=value`; the index of the next word to read. */
fn longOption(out : Input, word : string, argv : ArrayList<string>, next : i32) : i32 ! UsageError {
    let eq : i32 = word.indexOf("=");
    let name : string = eq < 0 ? sliceFrom(word, 2) : slice(word, 2, eq);
    let typed : string = "--" + name;
    let (found, opt) = findOption(out, name, "");
    if (!found) {
        if (name == "help") {
            out.askHelp();
            return next;
        }
        if (name == "version" && out.levels.at(0).ver != "") {
            out.askVersion();
            return next;
        }
        throw UnknownOption(typed, nearestWord(typed, longNames(out)));
    }
    if (!opt.takesValue()) {
        if (eq < 0) {
            out.put(opt.name, "true", Source::Argv);
        } else {
            let given : string = sliceFrom(word, eq + 1);
            if (given != "true" && given != "false") {
                throw InvalidValue(typed, given, "true or false", "");
            }
            out.put(opt.name, given, Source::Argv);
        }
        return next;
    }
    if (eq >= 0) {
        storeValue(out, opt, typed, sliceFrom(word, eq + 1));
        return next;
    }
    if (next >= argv.size() || looksLikeOption((argv.get(next) ?? ""))) {
        throw MissingValue(typed, opt.value);
    }
    storeValue(out, opt, typed, (argv.get(next) ?? ""));
    return next + 1;
}

/** Whether a word reads as the next option rather than as a value: `--x`, not `-1` or `-`. */
fn looksLikeOption(word : string) : bool {
    return word.startsWith("--") && word.length > 2;
}

/** `-a`, `-abc`, `-j4`, `-j 4`: letters read left to right until one takes a value. */
fn shortOptions(out : Input, word : string, argv : ArrayList<string>, next : i32) : i32 ! UsageError {
    let mut following : i32 = next;
    for (at of 1..word.length) {
        let letter : string = slice(word, at, at + 1);
        let typed : string = "-" + letter;
        let (found, opt) = findOption(out, "", letter);
        if (!found) {
            if (letter == "h") {
                out.askHelp();
                return following;
            }
            if (letter == "V" && out.levels.at(0).ver != "") {
                out.askVersion();
                return following;
            }
            throw UnknownOption(typed, "");
        }
        if (!opt.takesValue()) {
            out.put(opt.name, "true", Source::Argv);
            continue;
        }
        if (at + 1 < word.length) {
            storeValue(out, opt, typed, sliceFrom(word, at + 1));
            return following;
        }
        if (following >= argv.size() || looksLikeOption((argv.get(following) ?? ""))) {
            throw MissingValue(typed, opt.value);
        }
        storeValue(out, opt, typed, (argv.get(following) ?? ""));
        return following + 1;
    }
    return following;
}

/** Check `value` against what `opt` declares and record it. */
fn storeValue(out : Input, opt : Opt, typed : string, value : string) : void ! UsageError {
    if (!opt.accepts(value)) {
        let near : string = opt.kind == Kind::Choice ? nearestWord(value, opt.words()) : "";
        throw InvalidValue(typed, value, opt.expects(), near);
    }
    out.put(opt.name, value, Source::Argv);
}

/** Check the positional arguments against the command that runs. */
fn checkArguments(out : Input) : void ! UsageError {
    let c : Command = out.command();
    let mut needed : i32 = 0;
    let mut variadic : bool = false;
    for (i of 0..c.args.size()) {
        if (c.args.at(i).needed) {
            needed = i + 1;
        }
        if (c.args.at(i).variadic) {
            variadic = true;
        }
    }
    if (c.subs.size() > 0 && out.count() == 0 && c.args.size() == 0) {
        throw UsageError("a command is needed", "run with --help to list them");
    }
    if (out.count() < needed) {
        throw MissingArgument(c.args.at(out.count()).name);
    }
    if (!variadic && out.count() > c.args.size()) {
        throw UnexpectedArgument(out.at(c.args.size()));
    }
}

/**
 * Read `argv` against `root` without the defaults, so a caller can offer the environment and a file
 * first and then `seal()`.
 */
pub fn listenToRaw(root : Command, argv : ArrayList<string>) : Input ! UsageError {
    let out : Input = new Input();
    out.levels.add(root.copy());
    let mut i : i32 = 0;
    let mut literal : bool = false;
    while (i < argv.size()) {
        let word : string = (argv.get(i) ?? "");
        i = i + 1;
        if (literal || !word.startsWith("-") || word == "-") {
            if (!literal && out.count() == 0 && out.command().subs.size() > 0) {
                let at : i32 = out.command().findSub(word);
                if (at >= 0) {
                    out.levels.add(out.command().subs.at(at).copy());
                    continue;
                }
                if (out.command().args.size() == 0) {
                    let near : string = nearestWord(word, out.command().subNames());
                    throw UnknownCommand(word, near);
                }
            }
            out.push(word);
        } else if (word == "--") {
            literal = true;
        } else if (word.startsWith("--")) {
            i = longOption(out, word, argv, i);
        } else {
            i = shortOptions(out, word, argv, i);
        }
        if (out.helpAsked || out.versionAsked) {
            return out;
        }
    }
    checkArguments(out);
    return out;
}

/** Read `argv` (the arguments after the program's name) against `root`, defaults included. */
pub fn listenTo(root : Command, argv : ArrayList<string>) : Input ! UsageError {
    let out : Input = listenToRaw(root, argv);
    out.seal();
    return out;
}
