// spec — what a program accepts, declared once.
//
// A `Command` is a name, its options, its positional arguments and its subcommands. Everything the
// library does with a command line — parsing it, writing `--help`, completing it in a shell, reading
// the same names from a config file or the environment — reads this one description, so the program
// never states the same fact twice.
//
//     let serve : Command = Command::create("serve", "Run the server")
//         .add(Opt::integer("-p, --port <n>", "Port to listen on", "8080"))
//         .add(Opt::flag("-q, --quiet", "Print nothing but errors"))
//         .arg(Arg::required("root", "Folder to serve"));
//
// An option is declared by the way it is typed: `-p, --port <n>` is a short name, a long name and a
// value. The long name is what the program reads it by (`parsed.integer("port")`), the config file
// and the environment too.

use std::collections::ArrayList;
use crate::list::{Copy, Values};
use crate::text::{realNumber, slice, sliceFrom, wholeNumber};
use std::text::StringBuilder;

/** What an option's value must be. */
pub enum Kind : i32 {
    /** No value: present or absent. */
    Flag = 0,

    /** Any text. */
    Text = 1,

    /** A whole number. */
    Int = 2,

    /** A number that may have a fraction. */
    Float = 3,

    /** A path; not checked for existence here. */
    Path = 4,

    /** One of a fixed set of words. */
    Choice = 5,

    /** The word that names a value of this kind in a usage line. */
    pub fn word(self) : string {
        return match self {
            Kind::Flag => "",
            Kind::Text => "text",
            Kind::Int => "n",
            Kind::Float => "x",
            Kind::Path => "path",
            Kind::Choice => "choice",
        };
    }

    /** What is accepted, in a sentence. */
    pub fn expects(self) : string {
        return match self {
            Kind::Flag => "no value",
            Kind::Text => "text",
            Kind::Int => "a whole number",
            Kind::Float => "a number",
            Kind::Path => "a path",
            Kind::Choice => "one of the choices",
        };
    }
}

/** Whether `v` reads as a whole number. */
fn isWhole(v : string) : bool {
    let (ok, n) = wholeNumber(v);
    return ok;
}

/** Whether `v` reads as a number. */
fn isNumber(v : string) : bool {
    let (ok, x) = realNumber(v);
    return ok;
}

/**
 * An option: `--name`, with or without a value. It is plain data with a few questions to ask of it, and two
 * options are never the same object — so a `struct`, copied wherever it goes.
 */
pub struct Opt {
    /** The long name it is read by, without dashes. */
    pub name       : string;

    /** The one-letter form, without the dash; empty when it has none. */
    pub letter     : string;

    /** The name of its value in a usage line (`n` in `--port <n>`); empty for a flag. */
    pub value      : string;

    /** What its value must be. */
    pub kind       : Kind;

    /** The sentence `--help` shows beside it. */
    pub help       : string;

    /** What it is when nothing sets it; empty for none. */
    pub fallback   : string;

    /** For a `Choice`, the accepted words joined by `|`. */
    pub choices    : string;

    /** Whether it may be given several times; the values are then all kept. */
    pub repeatable : bool;

    /** Whether `--help` leaves it out (it still works). */
    pub hidden     : bool;

    /** An option as declared by `spec`, e.g. `-j, --jobs <n>`. */
    static fn declared(spec : string, help : string, kind : Kind, fallback : string, choices : string) : Opt {
        let (name, letter, value) = Opt::readSpec(spec);
        let mut shown : string = value;
        if (kind != Kind::Flag && value == "") {
            shown = kind.word();
        }
        return Opt {
            name: name,
            letter: letter,
            value: shown,
            kind: kind,
            help: help,
            fallback: fallback,
            choices: choices,
            repeatable: false,
            hidden: false,
        };
    }

    /** Cut the declaration into its three parts: long name, letter, value name. */
    static fn readSpec(spec : string) : (name: string, letter: string, value: string) {
        let mut name : string = "";
        let mut letter : string = "";
        let mut value : string = "";
        let mut word : string = "";
        for (i of 0..spec.length + 1) {
            let c : i32 = i < spec.length ? spec.charAt(i) : 32;
            if (c != 32 && c != 44) {
                word = word + slice(spec, i, i + 1);
                continue;
            }
            if (word.startsWith("--")) {
                name = sliceFrom(word, 2);
            } else if (word.startsWith("-")) {
                letter = sliceFrom(word, 1);
            } else if (word.startsWith("<")) {
                value = slice(word, 1, word.length - 1);
            }
            word = "";
        }
        return (name, letter, value);
    }

    /** A flag: `-v, --verbose`. */
    pub static fn flag(spec : string, help : string) : Opt {
        return Opt::declared(spec, help, Kind::Flag, "", "");
    }

    /** An option holding text; `fallback` is what it is when unset ("" for no default). */
    pub static fn text(spec : string, help : string, fallback : string) : Opt {
        return Opt::declared(spec, help, Kind::Text, fallback, "");
    }

    /** An option holding a whole number. */
    pub static fn integer(spec : string, help : string, fallback : string) : Opt {
        return Opt::declared(spec, help, Kind::Int, fallback, "");
    }

    /** An option holding a number with a fraction. */
    pub static fn number(spec : string, help : string, fallback : string) : Opt {
        return Opt::declared(spec, help, Kind::Float, fallback, "");
    }

    /** An option holding a path. */
    pub static fn path(spec : string, help : string, fallback : string) : Opt {
        return Opt::declared(spec, help, Kind::Path, fallback, "");
    }

    /** An option holding one of the words in `choices`, joined by `|`: `"text|json|csv"`. */
    pub static fn choice(spec : string, help : string, choices : string, fallback : string) : Opt {
        return Opt::declared(spec, help, Kind::Choice, fallback, choices);
    }

    /** An option that may be given again and again: `-I dir -I dir`. */
    pub static fn many(spec : string, help : string) : Opt {
        let mut o : Opt = Opt::declared(spec, help, Kind::Text, "", "");
        o.repeatable = true;
        return o;
    }

    /** Whether it carries a value. */
    pub fn takesValue(self) : bool {
        return self.kind != Kind::Flag;
    }

    /** The declaration as `--help` writes it: `-j, --jobs <n>`. */
    pub fn label(self) : string {
        let sb : StringBuilder = new StringBuilder();
        if (self.letter != "") {
            sb.append("-" + self.letter);
            if (self.name != "") {
                sb.append(", ");
            }
        } else {
            sb.append("    ");
        }
        if (self.name != "") {
            sb.append("--" + self.name);
        }
        if (self.takesValue()) {
            sb.append(" <" + self.value + ">");
        }
        return sb.toString();
    }

    /** The accepted words of a `Choice`, in order. */
    pub fn words(self) : ArrayList<string> {
        let out : ArrayList<string> = new ArrayList<string>();
        if (self.choices == "") {
            return out;
        }
        let mut word : string = "";
        for (i of 0..self.choices.length) {
            if (self.choices.charAt(i) == 124) {
                out.add(word);
                word = "";
            } else {
                word = word + slice(self.choices, i, i + 1);
            }
        }
        out.add(word);
        return out;
    }

    /** What is accepted, in a sentence: "a whole number", "one of text, json, csv". */
    pub fn expects(self) : string {
        if (self.kind != Kind::Choice) {
            return self.kind.expects();
        }
        let sb : StringBuilder = new StringBuilder();
        sb.append("one of ");
        let all : ArrayList<string> = self.words();
        for (i of 0..all.size()) {
            if (i > 0) {
                sb.append(", ");
            }
            sb.append((all.get(i) ?? ""));
        }
        return sb.toString();
    }

    /** Whether `v` is a value this option accepts. */
    pub fn accepts(self, v : string) : bool {
        return match self.kind {
            Kind::Flag => false,
            Kind::Text => true,
            Kind::Path => true,
            Kind::Int => isWhole(v),
            Kind::Float => isNumber(v),
            Kind::Choice => self.hasWord(v),
        };
    }

    /** Whether `v` is one of the choices. */
    fn hasWord(self, v : string) : bool {
        let all : ArrayList<string> = self.words();
        for (i of 0..all.size()) {
            if ((all.get(i) ?? "") == v) {
                return true;
            }
        }
        return false;
    }
}

/** A positional argument: plain data, so a `struct`. */
pub struct Arg {
    /** Its name in the usage line. */
    pub name     : string;

    /** The sentence `--help` shows beside it. */
    pub help     : string;

    /** Whether the command fails without it. */
    pub needed   : bool;

    /** Whether it takes all that remain (`<file>...`); only the last may. */
    pub variadic : bool;

    /** One that must be given. */
    pub static fn required(name : string, help : string) : Arg {
        return Arg { name: name, help: help, needed: true, variadic: false };
    }

    /** One that may be left out. */
    pub static fn optional(name : string, help : string) : Arg {
        return Arg { name: name, help: help, needed: false, variadic: false };
    }

    /** Zero or more, the last of the line. */
    pub static fn rest(name : string, help : string) : Arg {
        return Arg { name: name, help: help, needed: false, variadic: true };
    }

    /** How the usage line writes it: `<root>`, `[root]`, `[files...]`. */
    pub fn usage(self) : string {
        if (self.variadic) {
            return "[" + self.name + "...]";
        }
        return self.needed ? "<" + self.name + ">" : "[" + self.name + "]";
    }
}

/**
 * A sequence of commands. A `List` asks its rows to be `Copy`, and a command cannot say so of itself while
 * it is still being declared, so the commands inside a command are kept by this one.
 */
pub class Commands {
    rows : Command[];
    used : i32 = 0;
    room : i32;

    /** An empty sequence. */
    constructor() {
        self.room = 8;
        self.rows = malloc<Command>(self.room as i64);
    }

    /** Put `c` at the end; the sequence takes it over. */
    pub fn add(mut self, own c : Command) : void {
        if (self.used == self.room) {
            let mut bigger : Command[] = malloc<Command>((self.room * 2) as i64);
            for (i of 0..self.used) {
                bigger[i as i64] = self.rows[i as i64].copy();
            }
            self.rows = bigger;
            self.room = self.room * 2;
        }
        self.rows[self.used as i64] = c;
        self.used = self.used + 1;
    }

    /** How many there are. */
    pub fn size(self) : i32 {
        return self.used;
    }

    /** The one at position `i`. */
    pub fn at(self, i : i32) : Command {
        return self.rows[i as i64];
    }
}

/** A command: a program, or one of its subcommands. */
pub class Command : Copy<Command> {
    /** What it is typed as. */
    pub name    : string;

    /** One sentence on what it does. */
    pub about   : string;

    /** Its version; empty for none. Only the root's is shown by `--version`. */
    pub ver     : string = "";

    /** Other names it answers to. */
    pub aliases : ArrayList<string>;

    /** Its options. */
    pub opts    : Values<Opt>;

    /** Its positional arguments, in order. */
    pub args    : Values<Arg>;

    /** Its subcommands. */
    pub subs    : Commands;

    /** The example lines `--help` ends with, and what each does. */
    pub lines   : ArrayList<string>;
    pub notes   : ArrayList<string>;

    /** Whether `--help` leaves it out of its parent's list. */
    pub hidden  : bool = false;

    constructor(name : string, about : string) {
        self.name = name;
        self.about = about;
        self.aliases = new ArrayList<string>();
        self.opts = new Values<Opt>();
        self.args = new Values<Arg>();
        self.subs = new Commands();
        self.lines = new ArrayList<string>();
        self.notes = new ArrayList<string>();
    }

    /** A command named `name`, which `about` describes. */
    pub static fn create(name : string, about : string) : Command {
        return new Command(name, about);
    }

    /** Add an option; the command itself is returned, so declarations chain. */
    pub fn add(mut self, own o : Opt) : Command {
        self.opts.add(o);
        return self;
    }

    /** Add a positional argument. */
    pub fn arg(mut self, own a : Arg) : Command {
        self.args.add(a);
        return self;
    }

    /** Add a subcommand. */
    pub fn sub(mut self, own c : Command) : Command {
        self.subs.add(c);
        return self;
    }

    /** Let it answer to another name too. */
    pub fn alias(mut self, name : string) : Command {
        self.aliases.add(name);
        return self;
    }

    /** Give it a version. */
    pub fn version(mut self, v : string) : Command {
        self.ver = v;
        return self;
    }

    /** Add an example: the line as typed, and what it does. */
    pub fn example(mut self, line : string, note : string) : Command {
        self.lines.add(line);
        self.notes.add(note);
        return self;
    }

    /** The subcommand answering to `word` (by name or alias), or -1. */
    pub fn findSub(self, word : string) : i32 {
        for (i of 0..self.subs.size()) {
            let c : Command = self.subs.at(i);
            if (c.name == word || c.answers(word)) {
                return i;
            }
        }
        return -1;
    }

    /** Whether `word` is one of its aliases. */
    pub fn answers(self, word : string) : bool {
        for (i of 0..self.aliases.size()) {
            if ((self.aliases.get(i) ?? "") == word) {
                return true;
            }
        }
        return false;
    }

    /** The option whose long name is `name`, or -1. */
    pub fn findLong(self, name : string) : i32 {
        for (i of 0..self.opts.size()) {
            if (self.opts.at(i).name == name) {
                return i;
            }
        }
        return -1;
    }

    /** The option whose short name is `letter`, or -1. */
    pub fn findShort(self, letter : string) : i32 {
        for (i of 0..self.opts.size()) {
            if (self.opts.at(i).letter == letter) {
                return i;
            }
        }
        return -1;
    }

    /** Every name the subcommands answer to, for suggestions. */
    pub fn subNames(self) : ArrayList<string> {
        let out : ArrayList<string> = new ArrayList<string>();
        for (i of 0..self.subs.size()) {
            out.add(self.subs.at(i).name);
            let c : Command = self.subs.at(i);
            for (k of 0..c.aliases.size()) {
                out.add((c.aliases.get(k) ?? ""));
            }
        }
        return out;
    }

    /** A separate object with the same declaration, subcommands included. */
    pub fn copy(self) : Command {
        let mut c : Command = new Command(self.name, self.about);
        c.ver = self.ver;
        c.hidden = self.hidden;
        for (i of 0..self.aliases.size()) {
            c.aliases.add((self.aliases.get(i) ?? ""));
        }
        for (i of 0..self.opts.size()) {
            c.opts.add(self.opts.at(i));
        }
        for (i of 0..self.args.size()) {
            c.args.add(self.args.at(i));
        }
        for (i of 0..self.subs.size()) {
            c.subs.add(self.subs.at(i).copy());
        }
        for (i of 0..self.lines.size()) {
            c.lines.add((self.lines.get(i) ?? ""));
            c.notes.add((self.notes.get(i) ?? ""));
        }
        return c;
    }
}
