// args — the command line of the process, read against what the program declared.
//
//     let parsed : Parsed = parseProcess(spec());
//
// A program does not walk `argc()` and `argAt()` itself: the words it was started with are read here, once,
// and handed to the parser. `processWords()` is for the program that wants them as they are.

use crate::core::error::UsageError;
use crate::core::list::Values;
use crate::core::parse::{Parsed, parseLine, readLine};
use crate::core::spec::Command;
use std::sys::process::{argAt, argc};

/** The words the process was started with, after the program's name, as they were typed. */
pub fn processWords() : Values<string> {
    let out : Values<string> = new Values<string>();
    for (i of 1..argc()) {
        try {
            out.add(argAt(i));
        } catch e : IndexOutOfBoundsException {
            break;
        }
    }
    return out;
}

/** The process's own command line, read against `root`, defaults included. */
pub fn parseProcess(root : Command) : Parsed ! UsageError {
    return parseLine(root, processWords());
}

/**
 * The same without the defaults, so the environment and a file can be offered first and `seal()` called
 * after.
 */
pub fn readProcess(root : Command) : Parsed ! UsageError {
    return readLine(root, processWords());
}
