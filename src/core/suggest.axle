// suggest — "did you mean …?": the nearest word among those a program accepts.
//
// A mistyped command or option is nearly always one edit from the real one, so the nearest word by
// edit distance is a good guess when it is near enough. "Near enough" depends on length: one slip in a
// three-letter word is a third of it, in a ten-letter word a tenth. The cut is a third of the typed
// word, rounded up, and never less than one; a word past it is not suggested, because a wrong
// suggestion is worse than none.

use crate::core::list::Values;
use crate::core::text::{Str, Utf8};
use std::text::StringBuilder;

/** Distance between words, and the nearest of several. */
pub class Suggest {
    /**
     * The fewest insertions, deletions and substitutions that turn `a` into `b`, counted on bytes; a swap
     * of two neighbours counts as one edit (the commonest slip of the fingers).
     */
    pub static fn distance(a : string, b : string) : i32 {
        let n : i32 = a.byteLength as i32;
        let m : i32 = b.byteLength as i32;
        if (n == 0) {
            return m;
        }
        if (m == 0) {
            return n;
        }
        let width : i32 = m + 1;
        let mut grid : i32[] = malloc<i32>(((n + 1) * width) as i64);
        for (j of 0..m + 1) {
            grid[j as i64] = j;
        }
        for (i of 1..n + 1) {
            grid[(i * width) as i64] = i;
            for (j of 1..m + 1) {
                let same : bool = a.byteAt((i - 1) as i64) == b.byteAt((j - 1) as i64);
                let cost : i32 = same ? 0 : 1;
                let up : i32 = grid[((i - 1) * width + j) as i64] + 1;
                let left : i32 = grid[(i * width + j - 1) as i64] + 1;
                let diag : i32 = grid[((i - 1) * width + j - 1) as i64] + cost;
                let mut best : i32 = up.min(left).min(diag);
                if (i > 1 && j > 1 && a.byteAt((i - 1) as i64) == b.byteAt((j - 2) as i64)
                    && a.byteAt((i - 2) as i64) == b.byteAt((j - 1) as i64)) {
                    best = best.min(grid[((i - 2) * width + j - 2) as i64] + 1);
                }
                grid[(i * width + j) as i64] = best;
            }
        }
        return grid[(n * width + m) as i64];
    }

    /** How far a word may be from `typed` and still be offered. */
    pub static fn reach(typed : string) : i32 {
        let third : i32 = ((typed.byteLength as i32) + 2) / 3;
        return third < 1 ? 1 : third;
    }

    /**
     * The nearest of `words` to `typed`, or "" when none is within reach. Case does not count; the first
     * of equally near words wins, so the order the program lists its words in is the order of preference.
     */
    pub static fn nearest(typed : string, words : Values<string>) : string {
        let lowered : string = Suggest::lower(typed);
        let mut best : string = "";
        let mut bestAt : i32 = Suggest::reach(typed) + 1;
        for (i of 0..words.size()) {
            let d : i32 = Suggest::distance(lowered, Suggest::lower(words.at(i)));
            if (d < bestAt) {
                bestAt = d;
                best = words.at(i);
            }
        }
        return Str::copy(best);
    }

    /** `s` with the capitals of ASCII made small; every other codepoint is kept as it is. */
    pub static fn lower(s : string) : string {
        let sb : StringBuilder = new StringBuilder();
        let mut i : i64 = 0;
        while (i < s.byteLength) {
            let (cp, used) = Utf8::next(s, i);
            sb.appendChar(cp >= 65 && cp <= 90 ? cp + 32 : cp);
            i = i + (used as i64);
        }
        return sb.toString();
    }
}
