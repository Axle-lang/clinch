// error — what a command line can get wrong, and the status the process leaves with.
//
// A mistake of the person typing the command is a `UsageError`: it carries the words to show them
// (`message`), a `hint` when the program can guess what was meant, and the exit status 2, which is what
// the shells and `getopt` have always used for it. A fault of the setting the program runs in — a
// config file that does not parse — is a `ConfigError`, status 78. Both are `CliError`s, so a program
// that only wants "this failed, say so and leave" catches one type and reads `code`.
//
//   UsageError       the command line is not one this program accepts
//     UnknownCommand   a subcommand that does not exist: `suggestion` says the nearest that does
//     UnknownOption    an option that does not exist: the same
//     MissingValue     an option that takes a value was last, or was followed by nothing
//     MissingArgument  a required positional is absent
//     UnexpectedArgument  one positional too many
//     InvalidValue     a value of the wrong kind: `expected` says what would have done
//   ConfigError      a file, an environment variable or a default that cannot be used

use crate::core::text::copyOf;

// The statuses a process leaves with. They follow `sysexits.h` where it has a word for the case. They are
// constants, not an enum or a class of functions: `main` returns an `i32`, and `return EXIT_USAGE;` is all
// a program has to write.

/** The work was done. */
pub const EXIT_OK : i32 = 0;

/** The program ran and found nothing wrong, except what it was asked to report (as `grep` does). */
pub const EXIT_FAILED : i32 = 1;

/** The command line was not understood. */
pub const EXIT_USAGE : i32 = 2;

/** The data given was wrong in its content. */
pub const EXIT_DATA : i32 = 65;

/** An input that was named does not exist or cannot be read. */
pub const EXIT_NO_INPUT : i32 = 66;

/** A service the program needs is not available. */
pub const EXIT_UNAVAILABLE : i32 = 69;

/** An internal fault. */
pub const EXIT_SOFTWARE : i32 = 70;

/** The system failed an input or output operation. */
pub const EXIT_IO : i32 = 74;

/** A permission is missing. */
pub const EXIT_NO_PERMISSION : i32 = 77;

/** A configuration cannot be used. */
pub const EXIT_CONFIG : i32 = 78;

/** The person cancelled with Ctrl-C: 128 plus the signal's number, as a shell reports it. */
pub const EXIT_INTERRUPTED : i32 = 130;

/** The process was asked to stop with SIGTERM. */
pub const EXIT_TERMINATED : i32 = 143;

/**
 * "did you mean `x`?" for a suggestion, or nothing for none. It is a function, not a conditional inside the
 * call to `super`: the text must be a value of its own when the exception takes it.
 */
pub fn didYouMean(suggestion : string) : string {
    if (suggestion == "") {
        return "";
    }
    return "did you mean `" + suggestion + "`?";
}

/** Everything this library throws. */
pub exception CliError {
    /** The status the process should leave with. */
    pub code : i32;

    constructor(message : string, code : i32) {
        super(message);
        self.code = code;
    }
}

/** The command line is not one the program accepts. */
pub exception UsageError : CliError {
    /** What the program can guess was meant ("did you mean `--verbose`?"); empty when it cannot. */
    pub hint : string;

    constructor(message : string, hint : string) {
        super(message, EXIT_USAGE);
        self.hint = copyOf(hint);
    }

    /** What to print for it: the message, and under it the hint when there is one. */
    pub fn report(self) : string {
        if (self.hint == "") {
            return "error: " + self.message;
        }
        return "error: " + self.message + "\n  " + self.hint;
    }
}

/** A subcommand that does not exist. */
pub exception UnknownCommand : UsageError {
    /** What was typed. */
    pub name       : string;

    /** The nearest command that does exist; empty when none is near. */
    pub suggestion : string;

    constructor(name : string, suggestion : string) {
        super(
            "unknown command `" + name + "`",
            didYouMean(suggestion)
        );
        self.name = copyOf(name);
        self.suggestion = copyOf(suggestion);
    }
}

/** An option that does not exist. */
pub exception UnknownOption : UsageError {
    /** What was typed, with its dashes. */
    pub name       : string;

    /** The nearest option that does exist, with its dashes; empty when none is near. */
    pub suggestion : string;

    constructor(name : string, suggestion : string) {
        super(
            "unknown option `" + name + "`",
            didYouMean(suggestion)
        );
        self.name = copyOf(name);
        self.suggestion = copyOf(suggestion);
    }
}

/** An option that takes a value was given none. */
pub exception MissingValue : UsageError {
    /** The option, with its dashes. */
    pub option : string;

    constructor(option : string, expects : string) {
        super("option `" + option + "` needs a value", "give it as `" + option + " <" + expects + ">`");
        self.option = copyOf(option);
    }
}

/** A required positional argument is absent. */
pub exception MissingArgument : UsageError {
    /** Its name in the usage line. */
    pub argument : string;

    constructor(argument : string) {
        super("missing required argument <" + argument + ">", "");
        self.argument = copyOf(argument);
    }
}

/** More positional arguments than the command takes. */
pub exception UnexpectedArgument : UsageError {
    /** The first one that does not belong. */
    pub value : string;

    constructor(value : string) {
        super("unexpected argument `" + value + "`", "");
        self.value = copyOf(value);
    }
}

/** A value of the wrong kind or outside the choices. */
pub exception InvalidValue : UsageError {
    /** The option or argument it was given to, as the person typed it. */
    pub option     : string;

    /** The value. */
    pub value      : string;

    /** What would have been accepted: "a whole number", "one of text, json, csv". */
    pub expected   : string;

    /** The nearest accepted word, when the value was a near miss of one; empty otherwise. */
    pub suggestion : string;

    constructor(option : string, value : string, expected : string, suggestion : string) {
        super(
            "invalid value `" + value + "` for `" + option + "`: expected " + expected,
            didYouMean(suggestion)
        );
        self.option = copyOf(option);
        self.value = copyOf(value);
        self.expected = copyOf(expected);
        self.suggestion = copyOf(suggestion);
    }
}

/** A configuration that cannot be used. */
pub exception ConfigError : CliError {
    /** Where it came from: a file name, "environment", "defaults". */
    pub source : string;

    constructor(source : string, message : string) {
        super(source + ": " + message, EXIT_CONFIG);
        self.source = copyOf(source);
    }
}
